# =============================================================================
# MySANA QA Agent - local environment template
# =============================================================================
# Copy this file to ".env" and replace ONLY the placeholder values locally.
#
# NEVER commit .env.
# NEVER paste real API keys into .env.example, README, issues or pull requests.
# The repository .gitignore already excludes .env.
# =============================================================================

# Browser / MySANA
MYSANA_BASE_URL=https://mysana.sanahotels.com
QA_ALLOWED_HOSTS=mysana.sanahotels.com
QA_HEADLESS=false
QA_ALLOW_DANGEROUS_ACTIONS=false

# Optional: force a specific Chromium executable.
# Leave empty to auto-detect Chromium on Windows/PATH and fall back to Chrome.
QA_CHROMIUM_BINARY=

# Optional: custom QA browser profile.
# On Windows the default is:
# %LOCALAPPDATA%\MySANA-QA-Agent\browser-profile
QA_CHROME_PROFILE_DIR=

QA_VISUAL_ACTION_DELAY_MS=500
QA_VISUAL_TYPING_DELAY_MS=55

# Every click/write/select waits for explicit dashboard approval.
# 600 seconds = 10 minutes before the pending action is automatically rejected.
QA_APPROVAL_TIMEOUT_SECONDS=600

# Visual planner: OpenAI first for lower-latency testing.
# GPT-5.6 Luna accepts screenshots + text.
QA_VISION_MODEL=openai/gpt-5.6-luna

# LLM routing: OpenAI primary, then free fallbacks.
# Order matters: OpenAI -> Groq -> NVIDIA NIM.
QA_LLM_MODELS=openai/gpt-5.6-luna,groq/openai/gpt-oss-120b,nvidia_nim/z-ai/glm-5.3
QA_MAX_LLM_CALLS_PER_TASK=8
QA_MAX_AGENT_STEPS=10
QA_LLM_MAX_OUTPUT_TOKENS=1200
QA_LLM_TIMEOUT_SECONDS=60

# This only controls OpenAI when it is configured as a fallback.
# OpenAI is currently the PRIMARY provider above, so it is used even if this is false.
QA_ENABLE_PAID_FALLBACK=false

# Groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# NVIDIA NIM / NVIDIA Build
NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY_HERE
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Primary paid provider
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
